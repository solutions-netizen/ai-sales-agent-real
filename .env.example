# ── InsureFlow AI — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your real values.

# Server
PORT=5000
BASE_URL=https://your-domain.com

# Agent branding
AGENT_NAME=Andrea Edwards
AGENCY_NAME=Living Life Resources

# OpenAI (for AI scoring, call scripts, chat widget)
OPENAI_API_KEY=sk-...

# Twilio (for outbound calls and SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Brevo / Sendinblue (for email sequences — optional)
BREVO_API_KEY=xkeysib-...
